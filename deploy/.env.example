APP_ENV=production

# 浏览器访问入口端口，例如 WEB_PORT=18080 后访问 http://服务器IP:18080
WEB_PORT=8080

# 后端容器内部端口；Nginx 会使用同一个端口连接后端。
BACKEND_PORT=8080
MYSQL_PORT=3306
MYSQL_DATABASE=delivery_platform
MYSQL_USER=delivery
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_DRIVER=mysql
# 如果修改 MYSQL_USER/MYSQL_PASSWORD/MYSQL_DATABASE，请同步修改 DB_DSN。
DB_DSN=delivery:CHANGE_ME@tcp(mysql:3306)/delivery_platform?charset=utf8mb4&parseTime=True&loc=Local

# 必填：生产环境必须使用 32 位以上强随机字符串。
JWT_SECRET=

# 首次初始化空库时必填，用于创建第一个管理员账号。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
BOOTSTRAP_ADMIN_PASSWORD=

# 生产填实际 HTTPS 入口，例如 https://delivery.example.com
CORS_ORIGINS=https://delivery.example.com
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_DRY_RUN=true
SEED_DEMO_DATA=false
