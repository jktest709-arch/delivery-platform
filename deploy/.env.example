APP_ENV=production

# 浏览器访问入口端口，例如 WEB_PORT=18080 后访问 http://服务器IP:18080
WEB_PORT=8080

# 后端容器内部监听地址，通常无需修改；如果修改，Nginx 会跟随代理到该地址。
HTTP_ADDR=:8080
DB_DRIVER=mysql
DB_DSN=delivery:delivery@tcp(mysql:3306)/delivery_platform?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=please-change-this-secret
CORS_ORIGINS=http://localhost:8080
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
GITLAB_DRY_RUN=true
